# Capture the current working directory so that we can change to it later.
# Then capture the location of this script and the Directory Server instance
# root so that we can use them to create appropriate paths.
WORKING_DIR=`pwd`

cd "`dirname "${0}"`"
SCRIPT_DIR=`pwd`

cd ..
INSTALL_ROOT=`pwd`
export INSTALL_ROOT

cd "${WORKING_DIR}"


# Specify the script name so that it may be provided in command-line usage.
SCRIPT_NAME="start-ds"
export SCRIPT_NAME

# check for presence of lib/_svc-opendj.sh file
# If present, we should be on Solaris/OpenSolaris and use SMF to start
# OpenDJ.
# Check --exec. If not present, start OpenDJ from SMF

if test -f "${INSTALL_ROOT}/lib/_svc-opendj.sh"
then
    if [ "$1" = "--exec" ]
    then
        shift
    elif [ -z "$1" -o "$1" = "-L" -o "$1" = "-Q" -o "$1" = "-N" -o \
     "$1" = "--nodetach" -o "$1" = "-useLastKnownGoodConfig" \
     -o "$1" = "--quiet" ]
    then
# these options are only used when trying to start the server
# In this case, start it through the service.
        exec /usr/sbin/svcadm enable -t svc:/network/ldap/server:opendj
    fi
fi

# Set environment variables
SCRIPT_UTIL_CMD=set-full-server-environment-and-test-java
export SCRIPT_UTIL_CMD
.  "${INSTALL_ROOT}/lib/_script-util.sh"
RETURN_CODE=$?
if test ${RETURN_CODE} -ne 0
then
	exit ${RETURN_CODE}
fi

# Specify the locations of important files that may be used when the server
# is starting.
CONFIG_FILE=${INSTANCE_ROOT}/config/config.ldif
PID_FILE=${INSTANCE_ROOT}/logs/server.pid
LOG_FILE=${INSTANCE_ROOT}/logs/server.out
STARTING_FILE=${INSTANCE_ROOT}/logs/server.starting

stop_start_timer()
{
  if [ -n "${TIMER_PID}" ]
  then
    kill "${TIMER_PID}" 2>/dev/null
    wait "${TIMER_PID}" 2>/dev/null
    TIMER_PID=
  fi
}

cleanup_start()
{
  if [ -n "${STARTUP_TIMEOUT_FILE}" ]
  then
    rm -f "${STARTUP_TIMEOUT_FILE}"
  fi
  stop_start_timer
}

report_start_failure()
{
  CHILD_STATUS=running
  if ! kill -0 "${SERVER_PID}" 2>/dev/null
  then
    wait "${SERVER_PID}"
    CHILD_STATUS=$?
  fi
  START_FAILURE="start-ds: $1; server pid ${SERVER_PID}, status ${CHILD_STATUS}"
  if [ -n "${2:-}" ]
  then
    START_FAILURE="${START_FAILURE}
$2"
  fi
  printf '%s\n' "${START_FAILURE}" >&2
  {
    date -u '+%Y-%m-%dT%H:%M:%SZ'
    printf '%s\n' "${START_FAILURE}"
  } 2>/dev/null >> "${INSTANCE_ROOT}/logs/start-ds.log" || :
}

wait_for_startup()
{
  if [ "${START_TIMEOUT}" -gt 0 ]
  then
    sleep "${START_TIMEOUT}" > /dev/null &
    TIMER_PID=$!
  fi

  START_RESULT=0
  POLL_INTERVAL=0.1
  while [ -e "${STARTING_FILE}" ] && kill -0 "${SERVER_PID}" 2>/dev/null
  do
    if [ -n "${TIMER_PID}" ] && ! kill -0 "${TIMER_PID}" 2>/dev/null
    then
      wait "${TIMER_PID}" 2>/dev/null
      TIMER_PID=
      if [ -e "${STARTING_FILE}" ]
      then
        START_RESULT=2
      fi
      break
    fi
    if [ "$1" -eq 99 ]
    then
      # Bounded reads advance the same descriptor and allow rechecking startup.
      dd bs=8192 count=128 <&3 2>/dev/null
    fi
    if ! sleep "${POLL_INTERVAL}" 2>/dev/null
    then
      # Some Unix sleep implementations only accept whole seconds.
      POLL_INTERVAL=1
      sleep "${POLL_INTERVAL}"
    fi
  done
  if ! kill -0 "${SERVER_PID}" 2>/dev/null
  then
    START_RESULT=1
  fi
  stop_start_timer

  if [ "$1" -eq 99 ]
  then
    # Drain the startup log without following a server that keeps writing.
    LOG_SIZE=$(wc -c < "${LOG_FILE}")
    dd bs=8192 count=$(( (LOG_SIZE + 8191) / 8192 )) <&3 2>/dev/null
  fi

  case "${START_RESULT}" in
    1) report_start_failure "server exited before startup completed (see ${LOG_FILE})" ;;
    2) report_start_failure "startup timed out after ${START_TIMEOUT} seconds (use --timeout to increase it)" ;;
  esac
  return "${START_RESULT}"
}

# Remove the native libraries the BC FIPS loader extracts into the tmp directory
# on every start, so that they do not pile up. Nothing else in there is ours to
# remove: the tmp directory is java.io.tmpdir for every tool, and a tool may
# still be running - setup starts the server through this script and keeps its
# own log open (issue #1030). The logs a failed dsreplication or status run
# leaves there (opendj-replication-*.log, opendj-status-*.log) are the
# operator's to read and to remove; starting the server no longer takes them.
OPENDJ_TMP_DIR="${INSTANCE_ROOT}/tmp"
if [ -d "${OPENDJ_TMP_DIR}" ]; then
   rm -rf "${OPENDJ_TMP_DIR}"/bc-fips-jni_*
fi

# See if the provided set of arguments were sufficient for us to be able to
# start the server or perform the requested operation.  An exit code of 99
# means that it should be possible to start the server.  An exit code of 98
# means that the server is already running and we shouldn't try to start it.
# An exit code of anything else means that we're not trying to start the server
# and we can just exit with that exit code.
TIMER_PID=
START_TIMEOUT=
STARTUP_TIMEOUT_FILE=
trap cleanup_start 0
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
STARTUP_TIMEOUT_FILE=$(mktemp "${OPENDJ_TMP_DIR}/opendj-start-ds.XXXXXXXX" 2>/dev/null) ||
  STARTUP_TIMEOUT_FILE=$(mktemp /tmp/opendj-start-ds.XXXXXXXX 2>/dev/null) ||
  STARTUP_TIMEOUT_FILE=
if [ -n "${STARTUP_TIMEOUT_FILE}" ]
then
  set -- --startupTimeoutFile "${STARTUP_TIMEOUT_FILE}" "${@}"
fi
"${OPENDJ_JAVA_BIN}" -client ${SCRIPT_NAME_ARG} org.opends.server.core.DirectoryServer \
            --configFile "${CONFIG_FILE}" --checkStartability "${@}"
EC=${?}
if [ -n "${STARTUP_TIMEOUT_FILE}" ]
then
  shift 2
  IFS= read -r START_TIMEOUT < "${STARTUP_TIMEOUT_FILE}" || START_TIMEOUT=
  rm -f "${STARTUP_TIMEOUT_FILE}"
  STARTUP_TIMEOUT_FILE=
fi

if test ${EC} -eq 99 -o ${EC} -eq 103
then
  if [ -z "${START_TIMEOUT}" ]
  then
    printf '%s\n' 'start-ds: could not read the startup timeout' >&2
    exit 1
  fi
  : > "${LOG_FILE}" || exit 1
  touch "${STARTING_FILE}" || exit 1
  nohup "${OPENDJ_JAVA_BIN}" ${OPENDJ_JAVA_ARGS} ${SCRIPT_NAME_ARG} \
       org.opends.server.core.DirectoryServer \
       --configFile "${CONFIG_FILE}" "${@}" >> "${LOG_FILE}" 2>&1 &
  SERVER_PID=$!
  echo "${SERVER_PID}" > "${PID_FILE}"
  if test ${EC} -eq 99
  then
    wait_for_startup "${EC}" 3< "${LOG_FILE}"
  else
    wait_for_startup "${EC}"
  fi
  EC=${?}
  if test ${EC} -eq 0
  then
    # An exit code of 98 means that the server is already running.
    START_CHECK_OUTPUT=$("${OPENDJ_JAVA_BIN}" -client ${SCRIPT_NAME_ARG} org.opends.server.core.DirectoryServer \
            --configFile "${CONFIG_FILE}" --checkStartability 2>&1)
    EC=${?}
    if test ${EC} -eq 98
    then
    	exit 0
    else
      report_start_failure "checkStartability exited with status ${EC}" "${START_CHECK_OUTPUT}"
      exit 1
    fi
  fi
  exit ${EC}
else
  if test ${EC} -eq 100
  then
    #
    # run no detach
    #
    echo $$ > "${PID_FILE}"
    rm -f "${LOG_FILE}"
    exec "${OPENDJ_JAVA_BIN}" ${OPENDJ_JAVA_ARGS} ${SCRIPT_NAME_ARG} \
      org.opends.server.core.DirectoryServer \
      --configFile "${CONFIG_FILE}" "${@}"
  elif test ${EC} -eq 104
  then
    #
    # run no detach quiet
    #
    echo $$ > "${PID_FILE}"
    rm -f "${LOG_FILE}"
    exec "${OPENDJ_JAVA_BIN}" ${OPENDJ_JAVA_ARGS} ${SCRIPT_NAME_ARG} \
      org.opends.server.core.DirectoryServer \
      --configFile "${CONFIG_FILE}" "${@}" > /dev/null
  else
    #
    # an error or the server is already started.  Just return the code provided
    # by checkstartability
    #
    exit ${EC}
  fi
fi
